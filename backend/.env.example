# Copy to .env and fill in. Groq has a free tier: https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Alternatives:
# LLM_PROVIDER=ollama   LLM_MODEL=llama3.1   OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini   OPENAI_API_KEY=
# LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-4-5   ANTHROPIC_API_KEY=

EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
